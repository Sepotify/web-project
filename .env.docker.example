# Optional overrides for docker compose.
# Copy to .env in this folder if you want to change defaults:
#   copy .env.docker.example .env

POSTGRES_USER=spotify
POSTGRES_PASSWORD=spotify
POSTGRES_DB=spotify

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
DJANGO_SERVE_MEDIA=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456
SUPPORT_EMAIL=support@example.com
SUPPORT_PASSWORD=123456

FRONTEND_ORIGIN=http://localhost:3000
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback
NEXT_PUBLIC_API_URL=http://localhost:8000/api

BACKEND_PORT=8000
FRONTEND_PORT=3000
